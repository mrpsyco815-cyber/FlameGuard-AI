          "scientific_findings_verified": false,
          "nasa_id": "20000024924",
          "title": "Experimental Verification of Material Flammability in Space",
          "citation_url": "https://ntrs.nasa.gov/citations/20000024924"
        },
        {
          "text": "During   the  fire-  and  toxicology-safety     assessment,    the  air-purification    system   of the Mir  module  mock-up  was\nturned  off  to eliminate    its effect  on  the  air quality  and  to evaluate   the Skorost   filter  system.",
          "source_field": "pdf_page_text",
