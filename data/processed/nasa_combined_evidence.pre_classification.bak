          "citation_url": "https://ntrs.nasa.gov/citations/20000024924"
        },
        {
          "text": "The  gaseous  environment   was  analyzed   for the presence   of: oxygen,   carbon  monoxide,   carbon   dioxide,   unsatu-\nrated  hydrocarbons     (total),  and  saturated   hydrocarbons     (total).",
          "source_field": "pdf_page_text",
          "pdf_page_number": 15,
