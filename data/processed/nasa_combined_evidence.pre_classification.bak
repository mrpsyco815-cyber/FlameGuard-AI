          "citation_url": "https://ntrs.nasa.gov/citations/20000024924"
        },
        {
          "text": "The\nperformed   analysis   confirmed    that maximum   allowable   concentrations     lk)r a flight  of  long duration   (up  to\n180 days)  are  not exceeded,   and  carbon  monoxide    is not  detected.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 15,
          "source_url": "https://ntrs.nasa.gov/citations/20000024924",
          "matched_terms": [],
