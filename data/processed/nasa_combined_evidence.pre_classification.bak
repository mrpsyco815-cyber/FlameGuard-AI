          "citation_url": "https://ntrs.nasa.gov/citations/19960008387"
        },
        {
          "text": "At  higher   pressure,   the presence    of bright   soot  near  the  leading   edge  makes    it\nimpossible    for  the  photograph     to capture   the  entire   flame  image.",
          "source_field": "pdf_page_text",
