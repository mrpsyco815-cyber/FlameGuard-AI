        {
          "text": "thecontaminationofthespacecraftcompartment,theapparatusisequippedwithtwosetsof filters.Filteroperation\nwasevaluatedontheMir  full-scale  mock-up   (core  module)  during  the ground   preparation    for  the experiment.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 9,
          "source_url": "https://ntrs.nasa.gov/citations/20000024924",
          "matched_terms": [],
          "evidence_type": "extracted_source_text",
