      "passages": [
        {
          "text": "50th International Conference on Environmental Systems                                                    ICES-2021-102\n11-15 July 2021\n\n\n     Determining the Cause of Reduced Concurrent Flame Spread over\n            Thin Solid Fuels in Low Pressure and Low Gravity\n\n\n                             Maria Thomsen1 , Luca Carmignani2 and Carlos Fernandez-Pello3\n                           Dept.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 1,
