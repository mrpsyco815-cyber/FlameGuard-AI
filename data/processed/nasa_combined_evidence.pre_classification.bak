          "citation_url": "https://ntrs.nasa.gov/citations/20210017787"
        },
        {
          "text": "Saffire experiments correspond to Sibal, a\n from the FDS simulations as a function of ambient pressure for  cotton-fiberglass composite material, and not\n  different kinetic models.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 8,
          "source_url": "https://ntrs.nasa.gov/citations/20210017787",
          "matched_terms": [],
          "evidence_type": "extracted_source_text",
