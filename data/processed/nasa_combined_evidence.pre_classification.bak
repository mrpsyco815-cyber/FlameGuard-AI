          "citation_url": "https://ntrs.nasa.gov/citations/20000024924"
        },
        {
          "text": "Unfortunately,oxygenconcentration,whichisanimportantenvironmentalpropertythatdefinesmaterialcom-\nbustion,waselevatedatthetimeofthespaceexperiment.Moreover,oxygenconcentrationwasdifferentforall\nthreetestdays,orC,,,=22.5.23.6,and25.4percent,whichcomplicatesthetestdataanalysis.",
          "source_field": "pdf_page_text",
