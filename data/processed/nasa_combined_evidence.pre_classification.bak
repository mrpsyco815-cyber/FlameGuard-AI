        {
          "text": "Mechanical Engineering, University of California Berkeley, CA 94720\n\n                                                     Sonia Fereres4\n                                            Abengoa, Sevilla 41014, Spain\n\n                                                    and\n\n                                         David L.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 1,
          "source_url": "https://ntrs.nasa.gov/citations/20210017787",
          "matched_terms": [],
