        },
        {
          "text": "The  summary   section   of the Contractor's    Report   is written  by  the project   monitor,\nRobert  Friedman   of the NASA  Glenn  Research   Center.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 7,
