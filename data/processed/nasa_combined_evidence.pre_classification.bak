        },
        {
          "text": "For  polyethylene    and PMMA,   V,: differences   with  shape  are much\nless.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 14,
          "source_url": "https://ntrs.nasa.gov/citations/20000024924",
          "matched_terms": [],
