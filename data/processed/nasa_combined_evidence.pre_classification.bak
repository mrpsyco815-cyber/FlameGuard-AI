          "citation_url": "https://ntrs.nasa.gov/citations/20210017787"
        },
        {
          "text": "Time stamps show the instant the flame front reaches 33 mm.",
          "source_field": "pdf_page_text",
          "pdf_page_number": 10,
          "source_url": "https://ntrs.nasa.gov/citations/20210017787",
          "matched_terms": [],
          "evidence_type": "extracted_source_text",
