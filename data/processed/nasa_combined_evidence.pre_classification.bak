        },
        {
          "text": "r= 180sectoamaximumof2.9atr= 255(thetimeofflowshutoff)andthendecreasesto2.25atr= 310(inthe\ntimeperiodwhenthesamplecontinuestoburneventhoughV iszero).",
          "source_field": "pdf_page_text",
          "pdf_page_number": 20,
          "source_url": "https://ntrs.nasa.gov/citations/20000024924",
          "matched_terms": [],
          "evidence_type": "extracted_source_text",
