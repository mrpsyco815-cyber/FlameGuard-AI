        },
        {
          "text": "SUPPLEMENTARY NOTES\n\n        Pr(_ectManager,        RobertFriedman,        Microgravity      Science    Division,   NASA   Glenn   Research    Center,    organization     code\n        6711,(216)433-5697\n\n\n\n 12a.",
          "source_field": "pdf_page_text",
