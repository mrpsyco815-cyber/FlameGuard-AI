      "citation_url": "https://ntrs.nasa.gov/citations/20000024924",
      "pdf_page_number": 27,
      "evidence_class": "measured_result",
      "finding": "The paper reports limiting flow velocities of 0.5 cm/s for PMMA at 23.6% oxygen, 0.3?0.5 cm/s for polyethylene at 25.4% oxygen, and below 0.3 cm/s for Delrin at 25.4% oxygen.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20000024924-003",
