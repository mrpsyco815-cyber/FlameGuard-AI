      "citation_url": "https://ntrs.nasa.gov/citations/20000024924",
      "pdf_page_number": 27,
      "evidence_class": "experimental_observation",
      "finding": "The paper reports that after concurrent airflow was shut off, flame extinction in microgravity occurred within 5?20 seconds.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20000024924-004",
      "nasa_id": "20000024924",
      "title": "Experimental Verification of Material Flammability in Space",
      "citation_url": "https://ntrs.nasa.gov/citations/20000024924",
      "pdf_page_number": 27,
      "evidence_class": "reported_relationship",
      "finding": "The paper reports that flame-spread rate decreased as concurrent airflow velocity decreased. It reports 0.5?0.75 mm/s at 8.5 cm/s airflow and 0.01?0.05 mm/s at 0.3?0.5 cm/s airflow.",
      "review_status": "manually_reviewed_paper_reported_result",
