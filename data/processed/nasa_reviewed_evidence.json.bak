      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20210017787-001",
      "nasa_id": "20210017787",
      "title": "Determining the Cause of Reduced Concurrent Flame Spread over Thin Solid Fuels in Low Pressure and Low Gravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20210017787",
      "pdf_page_number": 7,
      "evidence_class": "experimental_and_simulation_result",
      "finding": "The paper reports that experimental and numerical flame-spread rates decrease as ambient pressure decreases. The authors also report that finite-rate chemistry simulations underpredicted experimental spread rates at higher pressures and did not allow flame spread in lower-pressure environments.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20210017787-002",
      "nasa_id": "20210017787",
      "title": "Determining the Cause of Reduced Concurrent Flame Spread over Thin Solid Fuels in Low Pressure and Low Gravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20210017787",
      "pdf_page_number": 7,
      "evidence_class": "simulation_limitation",
      "finding": "At 50 kPa, the FDS simulation using finite-rate chemistry showed only partial burning near the igniter. The flame blew off approximately 11 mm from the igniter, so no spread rate was determined for that condition.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20210017787-003",
      "nasa_id": "20210017787",
      "title": "Determining the Cause of Reduced Concurrent Flame Spread over Thin Solid Fuels in Low Pressure and Low Gravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20210017787",
      "pdf_page_number": 8,
      "evidence_class": "simulation_comparison",
      "finding": "FDS simulations show that reducing ambient pressure or gravity level decreases average flame-spread rate. The paper reports that a pressure reduction to 33 kPa produces flame-spread rates similar to those observed in microgravity.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20210017787-004",
      "nasa_id": "20210017787",
      "title": "Determining the Cause of Reduced Concurrent Flame Spread over Thin Solid Fuels in Low Pressure and Low Gravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20210017787",
      "pdf_page_number": 8,
      "evidence_class": "experimental_and_simulation_comparison",
      "finding": "The experiments and FDS simulations show decreasing pyrolysis length as ambient pressure and gravity level decrease. The authors report that pyrolysis length appears more sensitive to gravity changes than to pressure changes.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20210017787-005",
      "nasa_id": "20210017787",
      "title": "Determining the Cause of Reduced Concurrent Flame Spread over Thin Solid Fuels in Low Pressure and Low Gravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20210017787",
      "pdf_page_number": 9,
      "evidence_class": "simulation_result",
      "finding": "FDS simulations at 100 kPa show a linear trend of decreasing flame-spread rate as gravity level decreases. The paper reports comparable flame-spread rates at lunar gravity (0.17g) and 46 kPa, and at Martian gravity (0.38g) and 54 kPa.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-19960008387-001",
      "nasa_id": "19960008387",
      "title": "Solid Surface Combustion Experiment: Flame Spread in a Quiescent, Microgravity Environment",
      "citation_url": "https://ntrs.nasa.gov/citations/19960008387",
      "pdf_page_number": 1,
      "evidence_class": "experimental_scope",
      "finding": "The paper analyzes Solid Surface Combustion Experiment data from eight Space Shuttle missions between October 1990 and February 1995. The experiments included thin cellulosic filter-paper fuels and thick PMMA samples in quiescent microgravity environments.",
      "review_status": "manually_reviewed_paper_description",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-19960008387-002",
      "nasa_id": "19960008387",
      "title": "Solid Surface Combustion Experiment: Flame Spread in a Quiescent, Microgravity Environment",
      "citation_url": "https://ntrs.nasa.gov/citations/19960008387",
      "pdf_page_number": 2,
      "evidence_class": "experimental_result_and_model_comparison",
      "finding": "For thin cellulosic fuel, the paper reports an increase in experimental flame-spread rate with increasing ambient pressure. The radiation model agreed with experiments within 10%, while non-radiative models overpredicted spread rate by almost a factor of 2 to 3.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-19960008387-003",
      "nasa_id": "19960008387",
      "title": "Solid Surface Combustion Experiment: Flame Spread in a Quiescent, Microgravity Environment",
      "citation_url": "https://ntrs.nasa.gov/citations/19960008387",
      "pdf_page_number": 4,
      "evidence_class": "experimental_comparison",
      "finding": "The authors report that flame size and hang distance were much larger in microgravity than in downward flame propagation under normal gravity.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-19960008387-004",
      "nasa_id": "19960008387",
      "title": "Solid Surface Combustion Experiment: Flame Spread in a Quiescent, Microgravity Environment",
      "citation_url": "https://ntrs.nasa.gov/citations/19960008387",
      "pdf_page_number": 3,
      "evidence_class": "experimental_result_and_limitation",
      "finding": "For thick PMMA, the paper reports that experimental flame-spread rate decreased with distance. However, self-extinguishment was not observed in the experiments, possibly because the available fuel length was too short.",
      "review_status": "manually_reviewed_paper_reported_result",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-19960008387-005",
      "nasa_id": "19960008387",
      "title": "Solid Surface Combustion Experiment: Flame Spread in a Quiescent, Microgravity Environment",
      "citation_url": "https://ntrs.nasa.gov/citations/19960008387",
      "pdf_page_number": 4,
      "evidence_class": "computational_model_prediction",
      "finding": "The authors report that their models indicate flame spread may decrease and eventually extinguish, even at high oxygen levels. This is a model result, not an observed experimental extinction in the reported tests.",
      "review_status": "manually_reviewed_model_prediction",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20220012861-001",
      "nasa_id": "20220012861",
      "title": "Determining Flame Temperature By Broadband Two Color Pyrometry in A Flame Spreading Over A Thin Solid in Microgravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20220012861",
      "pdf_page_number": 7,
      "evidence_class": "experimental_result",
      "finding": "The reported flame temperature remained relatively constant during the flame-spread process, averaging approximately 1305 K soon after ignition and throughout the test.",
      "review_status": "manually_reviewed_against_extracted_page_text",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20220012861-002",
      "nasa_id": "20220012861",
      "title": "Determining Flame Temperature By Broadband Two Color Pyrometry in A Flame Spreading Over A Thin Solid in Microgravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20220012861",
      "pdf_page_number": 7,
      "evidence_class": "experimental_comparison",
      "finding": "At the thermocouple measurement location, B2CP estimated approximately 1369 K, compared with 1426 K from the thermocouple after radiation and convection corrections. The authors describe the measurements as comparable within the error margin.",
      "review_status": "manually_reviewed_against_extracted_page_text",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20220012861-003",
      "nasa_id": "20220012861",
      "title": "Determining Flame Temperature By Broadband Two Color Pyrometry in A Flame Spreading Over A Thin Solid in Microgravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20220012861",
      "pdf_page_number": 7,
      "evidence_class": "measurement_uncertainty",
      "finding": "A Monte Carlo propagation analysis using a conservative 5% uncertainty in the green-to-red signal ratio produced an estimated temperature uncertainty of 117 K for the B2CP technique.",
      "review_status": "manually_reviewed_against_extracted_page_text",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20220012861-004",
      "nasa_id": "20220012861",
      "title": "Determining Flame Temperature By Broadband Two Color Pyrometry in A Flame Spreading Over A Thin Solid in Microgravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20220012861",
      "pdf_page_number": 7,
      "evidence_class": "candidate_limitation",
      "finding": "Image saturation prevented reliable temperature extraction near the flame center, the most luminous region. Values at those locations were artificially set to zero for plotting and must not be interpreted as measured zero temperatures.",
      "review_status": "manually_reviewed_against_extracted_page_text",
      "scientific_findings_verified": false
    },
    {
      "evidence_id": "FG-20220012861-005",
      "nasa_id": "20220012861",
      "title": "Determining Flame Temperature By Broadband Two Color Pyrometry in A Flame Spreading Over A Thin Solid in Microgravity",
      "citation_url": "https://ntrs.nasa.gov/citations/20220012861",
      "pdf_page_number": 7,
      "evidence_class": "method_validation",
      "finding": "The authors report validating the B2CP methodology using numerical simulations and experimental measurements of well-known coflow flames. They state that the technique provides an acceptable average temperature but is biased toward higher values.",
      "review_status": "manually_reviewed_against_extracted_page_text",
